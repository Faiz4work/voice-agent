# Copy to .env and fill in. NEVER commit the real .env.

# Server
PORT=8000

# OpenAI — REQUIRED. Our /chat/completions custom-LLM endpoint uses this.
OPENAI_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini

# Supabase — Project Settings > API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_KEY=eyJ...            # use the service_role key (server-side only)

# Vapi (optional — for programmatic assistant/number management)
VAPI_API_KEY=...
