# Copy to .env. Never commit credentials or databases.
PORT=8000
APP_ENV=development
DATABASE_URL=sqlite:///./patients.db
# Hosted SQLite only: true requires a persistent disk and an absolute database path.
SQLITE_PERSISTENT=false
# Generate each secret with: python -c "import secrets; print(secrets.token_urlsafe(36))"
ADMIN_API_KEY=
VAPI_WEBHOOK_SECRET=

# AI website conversation. Groq has a free tier with rate limits.
# auto selects Groq when its key is set; otherwise OpenAI.
CHAT_PROVIDER=auto
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# OpenAI remains available as an optional alternative.
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini

# Vapi: only the PUBLIC key and assistant IDs are exposed to the browser.
VAPI_PUBLIC_KEY=
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_HVAC_ASSISTANT_ID=
VAPI_CREDENTIAL_ID=
VAPI_VOICE_ID=Savannah
SERVER_URL=
