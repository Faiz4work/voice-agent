{
  "name": "Savannah \u2014 Patient Registration",
  "firstMessage": "Thanks for calling CareCloud Medical, this is Savannah. I can get you registered as a new patient \u2014 can I start with your first and last name?",
  "endCallFunctionEnabled": true,
  "silenceTimeoutSeconds": 35,
  "maxDurationSeconds": 900,
  "backgroundSound": "office",
  "model": {
    "provider": "openai",
    "model": "gpt-4o-mini",
    "temperature": 0.5,
    "messages": [
      {
        "role": "system",
        "content": "PASTE THE SYSTEM PROMPT FROM prompt.md HERE"
      }
    ],
    "tools": [
      {
        "type": "function",
        "function": {
          "name": "register_patient",
          "description": "Save a NEW patient after the caller has confirmed the read-back. Only call once the caller says the details are correct.",
          "parameters": {
            "type": "object",
            "properties": {
              "first_name": {
                "type": "string",
                "description": "Legal first name"
              },
              "last_name": {
                "type": "string",
                "description": "Legal last name"
              },
              "date_of_birth": {
                "type": "string",
                "description": "MM/DD/YYYY"
              },
              "sex": {
                "type": "string",
                "enum": [
                  "Male",
                  "Female",
                  "Other",
                  "Decline to Answer"
                ]
              },
              "phone_number": {
                "type": "string",
                "description": "10-digit US number"
              },
              "address_line_1": {
                "type": "string",
                "description": "Street address"
              },
              "address_line_2": {
                "type": "string",
                "description": "Apt/Suite, optional"
              },
              "city": {
                "type": "string"
              },
              "state": {
                "type": "string",
                "description": "2-letter state code, e.g. CA"
              },
              "zip_code": {
                "type": "string",
                "description": "5-digit or ZIP+4"
              },
              "email": {
                "type": "string",
                "description": "Optional"
              },
              "insurance_provider": {
                "type": "string",
                "description": "Optional"
              },
              "insurance_member_id": {
                "type": "string",
                "description": "Optional"
              },
              "preferred_language": {
                "type": "string",
                "description": "Optional, default English"
              },
              "emergency_contact_name": {
                "type": "string",
                "description": "Optional"
              },
              "emergency_contact_phone": {
                "type": "string",
                "description": "Optional, 10 digits"
              }
            },
            "required": [
              "first_name",
              "last_name",
              "date_of_birth",
              "sex",
              "phone_number",
              "address_line_1",
              "city",
              "state",
              "zip_code"
            ]
          }
        }
      },
      {
        "type": "function",
        "function": {
          "name": "lookup_patient",
          "description": "Verify caller-provided phone, last name and date of birth. Never read patient details before verification.",
          "parameters": {
            "type": "object",
            "properties": {
              "phone_number": {
                "type": "string",
                "description": "10-digit US number"
              },
              "last_name": {
                "type": "string",
                "description": "Caller-provided last name for identity verification"
              },
              "date_of_birth": {
                "type": "string",
                "description": "Caller-provided DOB, YYYY-MM-DD"
              }
            },
            "required": [
              "phone_number",
              "last_name",
              "date_of_birth"
            ]
          }
        }
      },
      {
        "type": "function",
        "function": {
          "name": "update_patient",
          "description": "Update an existing patient record. Use the patient_id returned by lookup_patient or a DUPLICATE result. Only include fields being changed.",
          "parameters": {
            "type": "object",
            "properties": {
              "patient_id": {
                "type": "string",
                "description": "UUID of the existing patient"
              },
              "first_name": {
                "type": "string"
              },
              "last_name": {
                "type": "string"
              },
              "date_of_birth": {
                "type": "string",
                "description": "MM/DD/YYYY"
              },
              "sex": {
                "type": "string",
                "enum": [
                  "Male",
                  "Female",
                  "Other",
                  "Decline to Answer"
                ]
              },
              "phone_number": {
                "type": "string"
              },
              "address_line_1": {
                "type": "string"
              },
              "address_line_2": {
                "type": "string"
              },
              "city": {
                "type": "string"
              },
              "state": {
                "type": "string"
              },
              "zip_code": {
                "type": "string"
              },
              "email": {
                "type": "string"
              },
              "insurance_provider": {
                "type": "string"
              },
              "insurance_member_id": {
                "type": "string"
              },
              "preferred_language": {
                "type": "string"
              },
              "emergency_contact_name": {
                "type": "string"
              },
              "emergency_contact_phone": {
                "type": "string"
              },
              "verify_last_name": {
                "type": "string",
                "description": "Existing last name, supplied by caller for verification"
              },
              "verify_date_of_birth": {
                "type": "string",
                "description": "Existing DOB, supplied by caller for verification"
              }
            },
            "required": [
              "verify_last_name",
              "patient_id",
              "verify_date_of_birth"
            ]
          }
        }
      }
    ]
  },
  "voice": {
    "provider": "vapi",
    "voiceId": "Savannah"
  },
  "transcriber": {
    "provider": "deepgram",
    "model": "nova-2",
    "language": "en",
    "numerals": true
  },
  "server": {
    "url": "https://YOUR_BACKEND/webhook",
    "credentialId": "YOUR_VAPI_CREDENTIAL_ID"
  },
  "artifactPlan": {
    "recordingEnabled": false
  }
}
